selection name="plasma" summary="KDE Plasma Desktop" description="The KDE desktop environment." {
    depends {
        desktop-common
    }
    packages {
        ark
        bluedevil
        breeze-gtk-theme
        discover
        dolphin
        drkonqi
        elisa
        firefox
        flatpak
        flatpak-kcm
        font-hack
        font-noto
        font-noto-emoji
        gwenview
        haruna
        kaccounts-providers
        kalk
        kate
        kclock
        kde-cli-tools
        kde-gtk-config
        kdegraphics-thumbnailers
        kdepim-addons
        kdeplasma-addons
        kinfocenter
        kio-admin
        kio-gdrive
        kjournald
        kmag
        konsole
        krdp
        kscreen
        ksshaskpass
        kwallet-pam
        kwalletmanager
        kwrite
        liberation-fonts-ttf
        merkuro
        milou
        okular
        os-artwork
        partitionmanager
        plasma-browser-integration
        plasma-desktop
        plasma-disks
        plasma-nm
        plasma-pa
        plasma-systemmonitor
        plasma-thunderbolt
        plasma-welcome
        plasma-workspace-wallpapers
        plymouth-kcm
        polkit-kde-agent
        powerdevil
        skanlite
        spectacle
        "sysbinary(plymouthd)"
    }
}
