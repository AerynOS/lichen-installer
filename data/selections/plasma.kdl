        kclock
        kde-cli-tools
        kde-gtk-config
        kdegraphics-thumbnailers
        kdepim-addons
        kdeplasma-addons
        kinfocenter
        kio-admin
        kio-gdrive
        kjournald
        kmag
        konsole
        krdp
        kscreen
        ksshaskpass
        kwallet-pam
        kwalletmanager
        kwrite
        merkuro
        milou
        okular
        partitionmanager
        plasma-browser-integration
        plasma-desktop
        plasma-disks
        plasma-nm
        plasma-pa
        plasma-systemmonitor
        plasma-thunderbolt
        plasma-welcome
        plasma-workspace-wallpapers
        plymouth-kcm
        polkit-kde-agent
